   "cell_type": "code",
   "source": [
    "X = np.array([0.5, -1.2, 3.3])\n",
    "W = np.array([0.8, -0.5, 1.0])\n",
    "b = 0.2\n",
    "\n",
    "z = np.dot(W, X) + b\n",
    "output_purelin = purelin(z)\n",
    "\n",
    "print(\"Weighted sum(Z):\", z)\n",
    "print(\"Output with purelin (Linear):\", output_purelin)"
   ],
